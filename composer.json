{
  "name": "ariellcannal/inscricoes",
  "type": "project",
  "description": "Aplicação de inscrições com logging via Monolog",
  "homepage": "https://inscricoes.cannal.com.br",
  "license": "MIT",
  "require": {
    "php": ">=8.0.0",
    "dompdf/dompdf": "~2.0",
    "phpmailer/phpmailer": "~6.9",
    "ariellcannal/pagamentos": "dev-master",
    "monolog/monolog": "^3.5"
  },
  "require-dev": {
    "phpseclib/phpseclib": "~3.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:ariellcannal/pagamentos.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/ariellcannal/pagarme-php-sdk.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/inter-co/pj-sdk-php"
    }
  ],
  "autoload": {
    "psr-4": {
      "CANNALInscricoes\\Entities\\": "application/entities/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "notify-on-install": false
  }
}
